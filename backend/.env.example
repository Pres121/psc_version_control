# --- App ---
# production | staging | development
ENVIRONMENT=development
# Keep false in production (hides /docs and /redoc)
DOCS_ENABLED=true

# --- Supabase ---
# Use the SERVICE ROLE key here (server-side only). Never expose it to
# Flutter apps or the admin dashboard frontend. Never commit real keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional direct DB URL (not required when using the Supabase client)
DATABASE_URL=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ characters in production/staging
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# In production/staging you MUST list explicit origins (no "*"):
# ALLOWED_ORIGINS=["https://your-admin-dashboard.example.com"]
ALLOWED_ORIGINS=["*"]

# --- FCM (optional) ---
FCM_PROJECT_ID=your-firebase-project-id
# Either a path to the service-account json file, or the raw JSON as a string
FCM_CREDENTIALS_JSON=

# --- Rate limiting ---
UPDATE_CHECK_RATE_LIMIT=60/minute
LOGIN_RATE_LIMIT=10/minute
DOWNLOAD_RATE_LIMIT=30/minute
DEVICE_REGISTER_RATE_LIMIT=30/minute

# --- App binary storage ---
STORAGE_BUCKET=app-builds
PUBLIC_BASE_URL=https://psc-version-control.onrender.com
# --- Email / OTP (Gmail API) ---
# OAuth Web client from Google Cloud Console (Gmail API enabled)
GMAIL_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=YOUR_CLIENT_SECRET
# One-time: run  python scripts/get_gmail_refresh_token.py  (from backend/)
GMAIL_REFRESH_TOKEN=
# Gmail account that completed OAuth consent (must match sender)
GMAIL_SENDER_EMAIL=pscecosystem@gmail.com
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
